module pl.run

pub type Positive = Int where self > 0

pub capability Store {
    fn get(id: Int) -> Int
}

pub fn generic_and_effectful<T>(x: T, using db: Store) -> T
    effects { db.get }
{
    let _ = db.get(1)
    x
}

pub fn generic<T>(x: T) -> T {
    x
}

pub fn effectful(using db: Store) -> Int
    effects { db.get }
{
    db.get(1)
}

pub fn plain(n: Int) -> Int {
    n
}

pub fn nothing() -> Int {
    1
}

test "t" {
    assert true
}
