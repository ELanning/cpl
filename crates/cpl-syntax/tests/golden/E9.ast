(work
  (use reader.pages (items paginate Positive))
  (change pagination_update
    (base "main")
    (target "main")
    (workers 3)
    (task implementation
      (write paginate.body)
      (depend paginate.contract Positive.definition)
      (preserve paginate.signature paginate.contract paginate.effects paginate.verification_policy)
      (goal "Implement pagination and discharge its proof obligations.")
      (trivia blank))
    (task examples
      (add tests.pagination.*)
      (goal "Add boundary cases for empty input and partial final pages.")
      (trivia blank))
    (task audit
      (after implementation examples)
      (write)
      (goal "Review both patches against the frozen pagination contract.")
      (trivia blank))
    (integrate
      (require typecheck)
      (require (prove paginate))
      (require (test tests.pagination.*))
      (require (review audit))
      (require no_holes)
      (trivia blank))
    (trivia blank)))
