// a loop that never ends: a time budget
pub fn spin(n: Int) -> Int {
    var i = n
    while i >= 0 {
        i = i + 1
    }
    i
}

// a range bound that faults (S71): claimed by the property's range
property "a range bound that faults"
    for x in gen.range(0, zero_div(0))
{
    assert x >= 0
}
