    {
      "id": "pgn_7c2d",
      "path": "reader.pages.paginate",
      "provisional": false,
      "kind": "fn",
      "module": "reader.pages",
      "name": "paginate",
      "file": "src/reader/pages.cpl",
      "effects": [],
      "facets": {
        "identity": {
          "text": "pgn_7c2d",
          "hash": "bd3f91f48de8b527b3cb33c4f2b1b66b"
        },
        "name": {
          "text": "paginate",
          "hash": "c7c6593c3beabcd67c41127d206918f5"
        },
        "signature": {
          "text": "pub fn _<T>(items: List<T>, size: Positive) -> List<List<T>>",
          "hash": "11367ea8051ec723a2947f3c23cbc6be"
        },
        "contract": {
          "text": "ensures flatten(result) == items\nensures forall page in result: page.len > 0 and page.len <= size\nensures forall page in result.drop_last(): page.len == size",
          "hash": "b57e46d5b8e6685b08b351c8c667185d"
        },
        "effects": {
          "text": "",
          "hash": "af1349b9f5f9a1a6a0404dea36dcc949"
        },
        "body": {
          "text": "{\n    var pages: List<List<T>> = []\n    var rest = items\n    while rest.len > size\n        invariant flatten(pages) ++ rest == items\n        invariant forall page in pages: page.len == size\n        decreases rest.len\n    {\n        pages = pages.push(rest.take(size))\n        rest = rest.drop(size)\n    }\n    if not rest.is_empty() {\n        pages = pages.push(rest)\n    }\n    pages\n}",
          "hash": "7d1bb2835a6b401c0619ef13dc24e817"
        },
        "docs": {
          "text": "",
          "hash": "af1349b9f5f9a1a6a0404dea36dcc949"
        },
        "verification_policy": {
          "text": "@prove",
          "hash": "855639fcf39ddd0cba719e0c76039a29"
        }
      },
      "definition": "89b3dc79b6d7fb61f0ac85d1c984bb88"
    },
