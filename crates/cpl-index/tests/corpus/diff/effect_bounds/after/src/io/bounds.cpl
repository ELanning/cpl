module io.bounds

pub capability Db {
    fn get(id: Int) -> Int
    fn put(id: Int) -> Int
}

pub fn widen(using db: Db) -> Int
    effects { db.get, db.put }
{
    db.get(1)
}

pub fn narrow(using db: Db) -> Int
    effects { db.get }
{
    db.get(1)
}

pub fn swap(using db: Db) -> Int
    effects { db.put }
{
    db.get(1)
}

pub fn reorder(using db: Db) -> Int
    effects { db.get, db.put, db.get }
{
    db.get(1)
}

pub fn bound_added(using db: Db) -> Int
    effects { db.get }
{
    0
}

pub fn pure_fn() -> Int
    effects {}
{
    0
}
