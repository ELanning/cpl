module claims.cases

// D4 (spec/toolchain.md 12.6): every kind of claim site of semantics S34, S70, and S71, each with a fault raised
// while its clause is evaluated, and the "already claimed" path of S70; the stack guard and a time budget.

pub fn zero_div(n: Int) -> Int {
    10 / n
}

// a fault in a requires clause
pub fn req(n: Int) -> Int
    requires 10 / n > 0
{
    n
}

// in an ensures clause
pub fn ens(n: Int) -> Int
    ensures 10 / result > 0
{
    n
}

// in a header decreases
pub fn hdec(n: Int) -> Int
    decreases 10 / n
{
    0
}

// in a loop invariant
pub fn inv(n: Int) -> Int {
    var i = 0
    while i < 1
        invariant 10 / n > 0
        decreases 1 - i
    {
        i = i + 1
    }
    i
}

// in a loop decreases
pub fn ldec(n: Int) -> Int {
    var i = 0
    while i < 1
        decreases 10 / n
    {
        i = i + 1
    }
    i
}

// already claimed (S70): the clause of outer calls inner, whose own clause claims the fault first
pub fn inner(n: Int) -> Bool
    requires 10 / n > 0
{
    true
}

pub fn outer(n: Int) -> Int
    requires inner(n)
{
    n
}

// the stack guard (no depth limit) and the call-depth counter
pub fn deep(n: Int) -> Int
    requires n >= 0
{
    if n == 0 { 0 } else { deep(n - 1) + 1 }
}

// the stack guard: a branch never taken reserves a wide native frame (each let has its own slot), so the guard of the
// driver's 1 GiB stack trips after some hundred thousand frames rather than millions, and the backtrace, which is
