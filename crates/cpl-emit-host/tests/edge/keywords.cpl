pub fn cx(cx: Int, other: Int) -> Int {
    let tmp = cx + other
    tmp
}

pub fn r(r: Int, other: Int) -> Int {
    let tmp = r + other
    tmp
}

pub fn cpl(cpl: Int, other: Int) -> Int {
    let tmp = cpl + other
    tmp
}

