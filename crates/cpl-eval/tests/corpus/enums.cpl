module corpus.enums

// match on nested enums, `?` propagation, and `if` as an expression:
// semantics.md 3.8, 6.2, 5.2 step 5; grammar.md 3.12, 3.13, 5 (g), (j).

// why: describe(Ok(Some(3))) == "3": nested constructor patterns match
// variant then payload; the arm body calls the Int method to_text (stdlib.md 2.3).
// The argument's value JSON nests two tagged objects:
// {"$type": "Result", "$variant": "Ok", "$payload": [{"$type": "Option", "$variant": "Some", "$payload": [3]}]}.
fn describe(r: Result<Option<Int>, Text>) -> Text {
    match r {
        Ok(Some(n)) => n.to_text()
        Ok(None) => "none"
        Err(e) => e
    }
}

// why: word(-1) == "minus one": in pattern position `-1` is a single negative
// literal pattern (grammar.md 3.13, D48), matched before the wildcard arm.
fn word(n: Int) -> Text {
    match n {
        0 => "zero"
        -1 => "minus one"
        _ => "other"
    }
}

// why: sign(0) == 0: an `else if` chain is nested if_exprs (D49); neither
// condition holds, so the final else branch is the value.
fn sign(n: Int) -> Int {
    if n > 0 { 1 } else if n < 0 { -1 } else { 0 }
}

// why: bump(true, 1) == 2: `if` is a primary and may be an operand
// (grammar.md 3.12: `1 + if c { 1 } else { 2 }`); the whole if-expression is
// the right operand of `+`.
fn bump(c: Bool, n: Int) -> Int {
    n + if c { 1 } else { 0 }
}

fn require_positive(n: Int) -> Result<Int, Text> {
    if n > 0 { Ok(n) } else { Err("not positive") }
}

// why: early(-1, 0) == Err("not positive"): `?` on an Err exits the function
// at once with that Err as the exit value (semantics.md 6.2), so `x / b` with
// b == 0 is never evaluated and there is no fault.
// why: early(1, 0) is the fault division_by_zero: `?` yields 1 and the body
// continues into 1 / 0.
fn early(a: Int, b: Int) -> Result<Int, Text> {
    let x = require_positive(a)?
    Ok(x / b)
}
