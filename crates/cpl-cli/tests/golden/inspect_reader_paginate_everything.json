    "signature": "pub fn paginate<T>(items: List<T>, size: Positive) -> List<List<T>>",
    "contract": [
      "ensures flatten(result) == items",
      "ensures forall page in result: page.len >= 1 and page.len <= size",
      "ensures forall page in result.drop_last(): page.len == size"
    ],
    "effects": [],
    "docs": null,
    "implementation": "{\n    var pages: List<List<T>> = []\n    var rest = items\n    while rest.len > size\n        invariant flatten(pages) ++ rest == items\n        invariant forall page in pages: page.len == size\n        decreases rest.len\n    {\n        pages = pages.push(rest.take(size))\n        rest = rest.drop(size)\n    }\n    if not rest.is_empty() {\n        pages = pages.push(rest)\n    }\n    pages\n}",
    "holes": []
  },
