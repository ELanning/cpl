module tests.budget_props

fn slow_zero() -> Int {
    var i = 0
    while i < 200000 {
        i = i + 1
    }
    i - i
}

property "slow bound"
    for x in gen.range(slow_zero(), 2)
{
    assert x >= 0
}

property "spins from four"
    for n in gen.range(0, 10)
{
    var i = 0
    while i < 3 {
        i = i + 1
    }
    if n >= 4 {
        while true {
        }
    }
}

property "spins at zero"
    for n in gen.range(0, 10)
{
    if n == 0 {
        while true {
        }
    }
    assert n < 3
}
