module positive.else_if_chain_diverges

// Ruling (semantics S24 as amended, D-101): in an `else if` chain the else
// part is a further `if`, which diverges when all of its branches do, so
// the body below diverges and needs no tail expression.

fn sign(n: Int) -> Int {
    if n < 0 {
        return -1
    } else if n == 0 {
        return 0
    } else {
        return 1
    }
}
