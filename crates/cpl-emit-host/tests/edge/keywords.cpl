pub fn build(n: Int) -> Keywords { Keywords { impl: n, trait: n, mod: n, crate: n, dyn: n, ref: n, move: n, yield: n, func: n, chan: n, goto: n, range: n, select: n, package: n, import: n, defer: n, go: n, map: n, class: n, public: n, private: n, static: n, new: n, this: n, null: n, default: n, switch: n, case: n, extends: n, final: n, synchronized: n, throws: n, void: n, boolean: n, int: n, long: n, char: n, byte: n, super: n, instanceof: n, abstract: n, native: n, transient: n, volatile: n, record: n, sealed: n, permits: n, cx: n, r: n, cpl: n, java: n, std: n, core: n, box: n, unsafe: n, interface: n } }

pub fn sum(k: Keywords) -> Int {
    k.impl + k.trait + k.mod + k.crate + k.dyn + k.ref + k.move + k.yield + k.func + k.chan + k.goto + k.range + k.select + k.package + k.import + k.defer + k.go + k.map + k.class + k.public
}

pub fn pick(c: Choice) -> Int {
    match c {
        Default => 0
        New(new) => new + impl(new, 1)
        Class(class) => class.class + class.default
    }
}

pub mutate fn call(java: Int, using ops: Operations) -> Int
    effects { ops.impl, ops.default }
{
    ops.default(java)
    ops.impl(java, java)
}
