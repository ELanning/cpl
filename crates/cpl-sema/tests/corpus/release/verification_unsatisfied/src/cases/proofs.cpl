module cases.proofs

// Release case: with no verifier every `@prove` declaration has status
// `unknown`, which `--release` rejects with `verification_unsatisfied` (S36,
// T36); the `verification_result` info is still reported. Both span the
// function's name (semantics S63 [D-230]), so both markers name the `fn`
// line. No cpl.lock: `project_lock_missing`, span-less.
// expect-warning(global): project_lock_missing

// expect-info@+2: verification_result
@prove
pub fn absolute(n: Int) -> Int // expect-error: verification_unsatisfied
    ensures result >= 0
    ensures result == n or result == -n
{
    n.abs()
}

pub fn unproved_is_fine(n: Int) -> Int
    ensures result >= 0
{
    n.abs()
}
