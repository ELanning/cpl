/// Shared module, first file.
module mf.shared

// Directory case: `mf.shared` spans this file and mf/shared/extra.cpl
// (toolchain 3.7). Private declarations of either file are visible in the
// other without import; `use` lines are file-scoped (S5), so this file calls
// std.text qualified while extra.cpl imports `trim`.

pub type Positive = Int where self > 0

fn helper(n: Int) -> Int {
    n + 1
}

pub fn tidy(text: Text) -> Text {
    std.text.trim(text)
}

pub fn combined(n: Int) -> Int {
    helper(n) + extra_helper(n) + shout("x").len
}
