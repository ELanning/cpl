module impl.class

pub struct Keywords {
    impl: Int
    trait: Int
    mod: Int
    crate: Int
    dyn: Int
    ref: Int
    move: Int
    yield: Int
    func: Int
    chan: Int
    goto: Int
    range: Int
    select: Int
    package: Int
    import: Int
    defer: Int
    go: Int
    map: Int
    class: Int
    public: Int
    private: Int
    static: Int
    new: Int
    this: Int
    null: Int
    default: Int
    switch: Int
    case: Int
    extends: Int
    final: Int
    synchronized: Int
    throws: Int
    void: Int
    boolean: Int
    int: Int
    long: Int
    char: Int
    byte: Int
    super: Int
    instanceof: Int
    abstract: Int
    native: Int
    transient: Int
    volatile: Int
    record: Int
    sealed: Int
    permits: Int
    cx: Int
    r: Int
    cpl: Int
    java: Int
    std: Int
    core: Int
    box: Int
    unsafe: Int
    interface: Int
} where self.impl <= self.class + 1000000

pub enum Choice {
    Default
    New(Int)
    Class(Keywords)
}

pub interface Operations {
    fn impl(class: Int, func: Int) -> Int
    fn default(new: Int) -> Unit
}

pub fn impl(impl: Int, cx: Int) -> Int {
    let r = impl + cx
    var cpl = r * 2
    cpl = cpl - impl
    cpl
}

pub fn trait(trait: Int, cx: Int) -> Int {
    let r = trait + cx
    var cpl = r * 2
    cpl = cpl - trait
    cpl
}

