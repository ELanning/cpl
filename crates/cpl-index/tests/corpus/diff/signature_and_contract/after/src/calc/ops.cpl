module calc.ops

pub type Small = Int where self < 1000

@id("fn_dddddddddddddddd")
pub fn scale(a: Int, factor: Small) -> Int
    requires factor > 1
    ensures result >= a
{
    a * factor
}

pub capability Store {
    fn get(id: Int) -> Result<Int, Int>
    fn put(id: Int) -> Int
        requires id >= 0
}

pub struct Pair {
    left: Int
    right: Text
}

fn count(n: Int) -> Int
    requires n >= 0
    decreases n + 1
{
    0
}
