module negative.ambiguous_constructor_prelude

// A module variant named like a prelude constructor makes the unqualified
// name ambiguous where no type is expected (stdlib 1.3, S10).

pub enum Maybe {
    None
    Value(Int)
}

fn pick() -> Int {
    let _ = None // expect-error: ambiguous_constructor
    1
}

fn expected_type_disambiguates() -> Maybe {
    None
}
