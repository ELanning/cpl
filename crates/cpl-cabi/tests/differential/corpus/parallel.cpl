module parallel.rows

pure fn work(n: Int) -> Int {
    ((17 * 23 + 19) * 11) + (n + 0) * 1
}

pure fn batches(items: List<Int>) -> List<Int> {
    parallel for n in items: work(n)
}

pure fn captured(items: List<Int>, offset: Int) -> List<Int> {
    parallel for n in items: if n > 0 {
        let twice = n * 2
        twice + offset
    } else {
        offset
    }
}

pure fn nested(items: List<Int>) -> List<List<Int>> {
    parallel for n in items: (parallel for m in [1, 2, 3]: n + m)
}

pure fn divide(n: Int) -> Int {
    100 / n
}

pure fn failures(items: List<Int>) -> List<Int> {
    parallel for n in items: divide(n)
}

test "parallel maps retain input order" {
    assert captured([3, 0, 2], 7) == [13, 7, 11]
    assert nested([10, 20]) == [[11, 12, 13], [21, 22, 23]]
    assert batches([]) == []
}

pure fn snapshots(n: Int) -> List<List<Int>> {
    var xs: List<Int> = []
    var i = 0
    while i < n % 64 {
        xs = xs.push(i)
        i = i + 1
    }
    let old = xs
    xs = xs.push(n)
    [old, xs]
}

pure fn alias_argument() -> List<List<Int>> {
    var xs: List<List<Int>> = [[1]]
    let old = xs
    xs = xs.push(xs.first().unwrap_or([]))
    xs = xs.push([3])
    [flatten(old), flatten(xs)]
}

pure fn numbers(a: Int, b: Int) -> List<Int> {
    [a + b, a - b, a * b, a / b, a % b, (a + 0) * 1, (17 * 23 + 19) * 11]
}

pure fn fail_preserved(n: Int) -> Int {
    (100 / n) * 0
}

pure fn task_contract(n: Int) -> Int
    requires n > 0
{
    n
}

pure fn contracts(items: List<Int>) -> List<Int> {
    parallel for n in items: task_contract(n)
}

