module corpus.reader

// A copy of examples/reader/src/reader/pages.cpl under the corpus module
// path, so that the toolchain.md 12.3 interpreter example table and the
// semantics.md Section 11 `cpl run` expectations can be expressed as corpus
// cases. Only the module header is changed and `@id("pgn_7c2d")` is dropped
// (see holes.cpl). Consequently every qualified name below reads
// `corpus.reader.X` where the specifications say `reader.pages.X`
// (in particular the ConstraintError type_name "corpus.reader.Positive").
// The capability declarations and the `using` functions are kept for
// fidelity; they typecheck but cannot be run in Milestone 1 (stdlib.md S42).

use std.text.{trim}
// glue: parse_int is the standard-library decimal parser
// (Text -> Result<Int, ConstraintError>) that parse_size delegates to.
use std.text.{parse_int}

pub type PageId(Text)
pub type Positive = Int where self > 0

pub struct Page {
    id: PageId
    text: Text
}

pub enum StoreError {
    Missing(PageId)
    Unavailable
}

fn clean(page: Page) -> Page {
    Page { ..page, text: trim(page.text) }
}

// why: label(Err(Missing(PageId("p")))) == "Missing page": a nested pattern
// over a prelude enum, a user enum, and a wrapper; the argument's value JSON
// nests three tagged objects (Result, corpus.reader.StoreError, corpus.reader.PageId).
fn label(result: Result<Page, StoreError>) -> Text {
    match result {
        Ok(page) => page.text
        Err(Missing(_)) => "Missing page"
        Err(Unavailable) => "Storage unavailable"
    }
}

// glue: the design doc assumes parse_size returns Result<Int, ConstraintError>.
fn parse_size(text: Text) -> Result<Int, ConstraintError> {
    parse_int(trim(text))
}

// why: positive_size("  12 ") == Ok(12): trim, then parse_int, then
// check<Positive> (toolchain.md 12.3).
// why: positive_size("-3") == Err(ConstraintError { type_name:
// "corpus.reader.Positive", message: "-3 does not satisfy self > 0" }):
// parse_int("-3") is Ok(-3) (S25 accepts a sign) and the check fails; the
// value text of -3 is "-3" (semantics.md S40).
fn positive_size(text: Text) -> Result<Positive, ConstraintError> {
    let n = parse_size(text)?
    check<Positive>(n)
}

@prove
pub fn paginate<T>(items: List<T>, size: Positive) -> List<List<T>>
    ensures flatten(result) == items
    ensures forall page in result: page.len > 0 and page.len <= size
    ensures forall page in result.drop_last(): page.len == size
{
    var pages: List<List<T>> = []
    var rest = items

    while rest.len > size
        invariant flatten(pages) ++ rest == items
        invariant forall page in pages: page.len == size
        decreases rest.len
    {
        pages = pages.push(rest.take(size))
        rest = rest.drop(size)
    }

    if not rest.is_empty() {
        pages = pages.push(rest)
    }

    pages
}

// why: paginate_ints([1, 2, 3], 2) == Ok([[1, 2], [3]]): one full page, then
// the loop exits (1 > 2 is false) and the non-empty tail is pushed; every
// ensures and invariant of paginate holds (stdlib.md 4.3 worked check).
// why: paginate_ints([], 2) == Ok([]): the loop never runs and the empty tail
// is not pushed (design: "An empty input therefore produces an empty result").
// why: paginate_ints([1], 0) == Err(ConstraintError { type_name:
// "corpus.reader.Positive", message: "0 does not satisfy self > 0" }): the
// `?` returns the Err as a value (semantics.md Section 11); paginate is never
// entered.
pub fn paginate_ints(
    items: List<Int>,
    size: Int,
) -> Result<List<List<Int>>, ConstraintError>
{
    let checked_size = check<Positive>(size)?
    Ok(paginate(items, checked_size))
}

pub capability PageRead {
    fn get(id: PageId) -> Result<Page, StoreError>
}

pub capability PageWrite {
    fn put(page: Page) -> Result<Unit, StoreError>
}

pub fn load_page(
    id: PageId,
    using db: PageRead,
) -> Result<Page, StoreError>
    effects { db.get }
{
    db.get(id)
}

pub fn load_text(
    id: PageId,
    using db: PageRead,
) -> Result<Text, StoreError>
    effects { db.get }
{
    let page = load_page(id, using db)?
    Ok(page.text)
}

// why: divide_exactly(6, 3) == 2.
// why: divide_exactly(7, 0) is the fault contract_violation with clause_kind
// "requires", clause "b != 0", input {"a": 7, "b": 0}, attributed_to "caller"
// and no `caller` field (semantics.md Section 11); the second clause
// `a % b == 0` is never evaluated, so there is no division_by_zero.
// why: divide_exactly(7, 2) is the fault contract_violation with clause
// "a % b == 0": the first requires held and the second is the first false one.
fn divide_exactly(a: Int, b: Int) -> Int
    requires b != 0
    requires a % b == 0
    ensures result * b == a
{
    a / b
}
