module tests.twins

test "assert twin" {
    let a = 1
    var b = 2
    b = b + a
    let o: Option<Bool> = Some(true)
    match o {
        Some(v) => {
            let c = [v]
            assert c.len == 2
        }
        None => {
            assert false
        }
    }
}

test "hole twin" {
    let a = 1
    var b = 2
    b = b + a
    let o: Option<Bool> = Some(true)
    match o {
        Some(v) => {
            let c = [v]
            assert ?twin
        }
        None => {
            assert false
        }
    }
}

test "after blocks assert" {
    let a = 1
    if a > 0 {
        let inner = 5
        assert inner > 0
    }
    var i = 0
    while i < 2 {
        let step = 1
        i = i + step
    }
    let o: Option<Int> = Some(4)
    match o {
        Some(v) => {
            assert v == 4
        }
        None => {}
    }
    assert a == 0
}

test "after blocks hole" {
    let a = 1
    if a > 0 {
        let inner = 5
        assert inner > 0
    }
    var i = 0
    while i < 2 {
        let step = 1
        i = i + step
    }
    let o: Option<Int> = Some(4)
    match o {
        Some(v) => {
            assert v == 4
        }
        None => {}
    }
    assert ?after
}

test "forall hole" {
    let xs = [1, 2]
    assert forall v in xs: v > ?h
}

property "assert twin property"
    for x in gen.range(0, 3)
    for n in gen.positive_int
    for o in gen.option(gen.positive_int)
{
    let a = x + 1
    assert a < 0
}

property "hole twin property"
    for x in gen.range(0, 3)
    for n in gen.positive_int
    for o in gen.option(gen.positive_int)
{
    let a = x + 1
    assert ?twin_p
}
