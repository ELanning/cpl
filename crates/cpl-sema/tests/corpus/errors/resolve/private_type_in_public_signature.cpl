module negative.private_type_in_public_signature

// Every type in a public signature must be exportable (semantics 1.5). The
// offending type expression is the primary span; `symbol` is the public
// declaration, `facet` is "signature", `type` the private type.

type Secret(Text)

type Small = Int where self < 10

pub fn reveal(s: Secret) -> Int { // expect-error: private_type_in_public_signature
    1
}

pub fn produce(n: Int) -> Secret { // expect-error: private_type_in_public_signature
    Secret("x")
}

pub fn bound(n: Small) -> Int { // expect-error: private_type_in_public_signature
    n
}

pub struct Holder { // expect-error@+1: private_type_in_public_signature
    inner: Secret
}

pub enum Carrier { // expect-error@+1: private_type_in_public_signature
    Wrapped(Secret)
    Empty
}

pub type Outer(Secret) // expect-error: private_type_in_public_signature

pub type Tiny = Small where self > 0 // expect-error: private_type_in_public_signature
