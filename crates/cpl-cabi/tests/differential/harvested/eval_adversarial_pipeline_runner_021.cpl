module tests.asserts

fn checked_half(n: Int) -> Int {
    let h = n / 2
    assert h * 2 == n
    h
}

test "spacing" {
    let a = 1
    var b = [a]
    b = b.push(2)
    assert   a+1 ==  3
}

test "parentheses" {
    assert (1 + 1) == 3
}

test "blocks" {
    let x = 0
    assert if x > 0 { true } else { false }
}

test "arms" {
    let x = 0
    assert match x {
        0 => false
        _ => true
    }
}

test "commented" {
    let x = 0
    assert match x {
        // zero is the failing case
        0 => false
        _ => true
    }
}

test "let in a block" {
    let x = 1
    assert if x > 0 {
        let m = x
        m > 10
    } else {
        false
    }
}

test "two lines" {
    let x = 0
    assert (x == 1
        or x == 2)
}

test "called" {
    let _ = checked_half(7)
}

test "faulting assert" {
    let zero = 0
    assert 1 / zero == 0
}
