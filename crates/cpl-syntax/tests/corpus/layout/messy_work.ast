(work
  (use reader.pages (items paginate))
  (change c
    (integrate (require typecheck))
    (task t (after a b) (goal "g") (preserve paginate.contract) (write paginate.body))
    (task a (goal "a"))
    (task b)
    (workers 1)
    (target "main")
    (base "main"))
  (change d (base "x") (target "y")))
